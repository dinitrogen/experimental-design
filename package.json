{
  "name": "experimental-design",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-build-info.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "ng build",
    "prewatch": "node scripts/write-build-info.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/write-build-info.mjs",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,firestore,functions",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "cd functions && npm run build && cd .. && firebase deploy --only functions"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/fire": "^21.0.0-rc.2",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "^21.2.25",
    "firebase": "^12.19.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.47",
    "marked": "^17.0.6",
    "ngx-markdown": "^21.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@firebase/rules-unit-testing": "^5.0.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
